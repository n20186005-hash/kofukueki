---
import { navItems, site } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="sticky top-0 z-50 border-b border-wood/10 bg-paper/92 backdrop-blur-xl">
  <div class="mx-auto flex h-[var(--header-height)] max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-10">
    <a href="/" class="group flex items-center gap-3" aria-label={`${site.name} ホーム`}>
      <span class="grid size-10 place-items-center rounded-full border border-ticket/45 bg-ticket-pale font-serif-jp text-lg text-wood transition group-hover:rotate-[-4deg]">福</span>
      <span class="leading-none">
        <span class="block font-serif-jp text-xl tracking-[0.16em] text-wood-deep">幸福駅</span>
        <span class="mt-1 block text-[10px] tracking-[0.22em] text-ink-soft">KOFUKU STATION GUIDE</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="メインナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-full px-4 py-2 text-sm tracking-[0.04em] transition',
            isActive(item.href)
              ? 'bg-ticket-pale text-wood-deep'
              : 'text-ink-soft hover:bg-white/70 hover:text-wood-deep',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <a href="/access/" class="inline-flex items-center gap-2 rounded-full bg-wood-deep px-5 py-2.5 text-sm text-white transition hover:bg-wood">
        <span>旅のアクセス</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <button
      id="menu-button"
      type="button"
      class="grid size-11 place-items-center rounded-full border border-wood/15 bg-white/70 lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="メニューを開く"
    >
      <span class="relative block h-4 w-5" aria-hidden="true">
        <span class="absolute left-0 top-0 h-px w-5 bg-wood transition"></span>
        <span class="absolute left-0 top-[7px] h-px w-5 bg-wood transition"></span>
        <span class="absolute left-0 top-[14px] h-px w-5 bg-wood transition"></span>
      </span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-wood/10 bg-paper px-5 pb-6 pt-3 lg:hidden">
    <nav class="mx-auto grid max-w-7xl gap-1" aria-label="モバイルナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'flex items-center justify-between rounded-2xl px-4 py-3.5 text-base',
            isActive(item.href) ? 'bg-ticket-pale text-wood-deep' : 'text-ink-soft',
          ]}
        >
          <span>{item.label}</span><span aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    button.setAttribute('aria-label', open ? 'メニューを開く' : 'メニューを閉じる');
    menu?.classList.toggle('hidden', open);
  });
</script>
