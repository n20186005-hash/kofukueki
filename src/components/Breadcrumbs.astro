---
interface Item { label: string; href?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<nav aria-label="パンくずリスト" class="text-xs tracking-[0.08em] text-ink-soft/75">
  <ol class="flex flex-wrap items-center gap-2">
    <li><a href="/" class="hover:text-wood">ホーム</a></li>
    {items.map((item) => (
      <>
        <li aria-hidden="true">/</li>
        <li>{item.href ? <a href={item.href} class="hover:text-wood">{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>
      </>
    ))}
  </ol>
</nav>
