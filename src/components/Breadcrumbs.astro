---
import type { Locale } from '../i18n';
interface Item { label: string; href?: string }
interface Props { items: Item[]; locale?: Locale; }
const { items, locale = 'ja' } = Astro.props;

const homeLabel: Record<Locale, string> = { ja: 'ホーム', zh: '首頁', en: 'Home', ko: '홈' };
const ariaLabel: Record<Locale, string> = { ja: 'パンくずリスト', zh: '麵包屑導覽', en: 'Breadcrumb', ko: '브레드크럼브' };
---
<nav aria-label={ariaLabel[locale]} class="text-xs tracking-[0.08em] text-ink-soft/75">
  <ol class="flex flex-wrap items-center gap-2">
    <li><a href={locale === 'ja' ? '/' : `/${locale}/`} class="hover:text-wood">{homeLabel[locale]}</a></li>
    {items.map((item) => (
      <>
        <li aria-hidden="true">/</li>
        <li>{item.href ? <a href={item.href} class="hover:text-wood">{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>
      </>
    ))}
  </ol>
</nav>
