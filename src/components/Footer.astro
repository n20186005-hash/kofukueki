---
import { ui, localizedPath, type Locale } from '../i18n';
interface Props { locale?: Locale; path?: string }
const { locale = 'ja' } = Astro.props;
const names: Record<Locale,string> = { ja:'幸福駅', zh:'幸福車站', en:'Former Kofuku Station', ko:'고후쿠역' };
const rights: Record<Locale,string> = { ja:'無断転載を禁じます', zh:'版權所有', en:'All rights reserved', ko:'모든 권리 보유' };
const legal: Record<Locale,{privacy:string;terms:string;cookies:string}> = {
  ja:{privacy:'プライバシーポリシー',terms:'利用規約',cookies:'Cookie 設定'},
  zh:{privacy:'隱私政策',terms:'服務條款',cookies:'Cookie 設定'},
  en:{privacy:'Privacy Policy',terms:'Terms of Service',cookies:'Cookie Settings'},
  ko:{privacy:'개인정보 처리방침',terms:'이용약관',cookies:'Cookie 설정'},
};
const links = [
  { path:'/privacy-policy/', label:legal[locale].privacy },
  { path:'/terms-of-service/', label:legal[locale].terms },
  { path:'/cookie-settings/', label:legal[locale].cookies },
];
---
<footer class="mt-24 border-t border-wood/10 bg-wood-deep text-white sm:mt-32">
  <div class="mx-auto max-w-7xl px-5 py-10 sm:px-8 lg:px-10">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm text-white/90">© 2026 {names[locale]} · {rights[locale]}</p>
        <p class="mt-3 text-sm leading-7 text-white/65">{ui[locale].footerDisclaimer}</p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/80 lg:justify-end" aria-label={legal[locale].privacy}>
        {links.map(link => <a href={localizedPath(link.path, locale)} class="underline decoration-white/30 underline-offset-4 hover:text-white">{link.label}</a>)}
      </nav>
    </div>
  </div>
</footer>
