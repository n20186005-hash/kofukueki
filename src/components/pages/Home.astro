---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import RouteMap from '../../components/RouteMap.astro';
import { quickFacts, highlights, timeline, faqs, pages } from '../../i18n/content';
import { site, rating } from '../../data/site';
import { nearbyText, nearbyInfo, nearbySlugs } from '../../data/nearby';
import { localizedPath } from '../../i18n';
import { getUi } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props { locale: Locale; title?: string; description?: string; }
const { locale, title, description } = Astro.props;
const ut = getUi(locale);
const t = pages[locale].home;
const qf = quickFacts[locale];
const hl = highlights[locale];
const tl = timeline[locale];
const fq = faqs[locale];
const nearbyDistance: Record<Locale, [string, string]> = { ja: ['車で約15分', '徒歩約15分'], zh: ['車程約15分鐘', '步行約15分鐘'], en: ['About 15 min by car', 'About 15 min on foot'], ko: ['차로 약15분', '도보 약15분'] };

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: '幸福駅',
  alternateName: ['旧幸福駅', '幸福鉄道公園', 'Kofuku Station'],
  description: site.description,
  url: site.url,
  image: [`${site.url}/images/hero-1920.webp`, `${site.url}/images/station-1440.webp`],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '幸福町東1線161',
    addressLocality: '帯広市',
    addressRegion: '北海道',
    postalCode: '089-1246',
    addressCountry: 'JP',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.coordinates.lat, longitude: site.coordinates.lng },
  touristType: ['鉄道ファン', 'カップル', '家族旅行', '写真旅行'],
  sameAs: ['https://maps.app.goo.gl/5tG7m8dAcZR5knuE7'],
};
---
<BaseLayout locale={locale} path="/" title={title} description={description} jsonLd={attractionSchema}>
  <section class="relative min-h-[calc(100svh-var(--header-height))] overflow-hidden bg-wood-deep text-white hero-vignette">
    <picture class="absolute inset-0">
      <source media="(max-width: 720px)" srcset="/images/hero-960.webp" />
      <source media="(max-width: 1500px)" srcset="/images/hero-1440.webp" />
      <img class="h-full w-full object-cover object-center" src="/images/hero-1920.webp" width="1920" height="1280" fetchpriority="high" alt={t.heroEyebrow} />
    </picture>

    <div class="relative z-10 mx-auto flex min-h-[calc(100svh-var(--header-height))] max-w-7xl flex-col justify-end px-5 pb-10 pt-24 sm:px-8 sm:pb-14 lg:px-10 lg:pb-16">
      <div class="max-w-4xl" data-reveal>
        <p class="rule-line text-xs tracking-[0.25em] text-ticket-soft">{t.heroEyebrow}</p>
        <h1 class="mt-7 text-balance font-serif-jp text-[clamp(2.25rem,5.2vw,4.5rem)] leading-[1.15] tracking-[0.06em]">
          {t.heroTitleMain}
        </h1>
        <p class="mt-3 font-serif-jp text-xl tracking-[0.12em] text-ticket-soft sm:text-2xl">{t.heroTitleLines[0]}{t.heroTitleLines[1]}</p>
        <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-black/25 px-4 py-1.5 text-sm text-white/90 backdrop-blur">{ut.ratingLabel} <strong class="text-ticket-soft">{rating.value}</strong>（{rating.count.toLocaleString('en-US')}）</p>
        <p class="mt-6 max-w-2xl text-base leading-8 text-white/78 sm:text-lg">
          {t.heroSubLines[0]}<br class="hidden sm:block" />{t.heroSubLines[1]}
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={locale === 'ja' ? '/access/' : `/${locale}/access/`} class="inline-flex items-center gap-3 rounded-full bg-ticket px-6 py-3.5 text-sm font-medium text-wood-deep transition hover:bg-ticket-soft">
            {t.cta1} <span aria-hidden="true">→</span>
          </a>
          <a href="#story" class="inline-flex items-center gap-3 rounded-full border border-white/35 bg-black/10 px-6 py-3.5 text-sm text-white backdrop-blur transition hover:bg-white/10">
            {t.cta2} <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="mt-14 grid border-t border-white/20 pt-5 text-sm sm:grid-cols-3 sm:gap-8 lg:max-w-3xl" data-reveal>
        <div class="py-2"><span class="text-white/50">{qf[0].label}</span><strong class="ml-4 font-normal">{qf[0].value}</strong></div>
        <div class="py-2"><span class="text-white/50">{qf[2].label}</span><strong class="ml-4 font-normal">{qf[2].value}</strong></div>
        <div class="py-2"><span class="text-white/50">{qf[1].label}</span><strong class="ml-4 font-normal">{qf[1].value}</strong></div>
      </div>
    </div>

    <p class="vertical-label absolute bottom-10 right-5 z-10 hidden text-[10px] tracking-[0.25em] text-white/45 md:block lg:right-10">KOFUKU STATION · TOKACHI</p>
  </section>

  <section class="relative z-20 mx-auto -mt-1 max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="grid overflow-hidden rounded-b-[2rem] bg-ticket-pale shadow-soft sm:grid-cols-2 lg:grid-cols-4">
      {qf.map((item, index) => (
        <div class:list={['px-6 py-7 sm:px-8', index > 0 && 'border-t border-ticket/20 sm:border-t-0 sm:border-l']}>
          <p class="text-xs tracking-[0.16em] text-ink-soft">{item.label}</p>
          <p class="mt-2 font-serif-jp text-2xl tracking-[0.04em] text-wood-deep">{item.value}</p>
          <p class="mt-2 text-xs leading-5 text-ink-soft/75">{item.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="story" class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-24">
      <div class="lg:sticky lg:top-28">
        <SectionHeading eyebrow={t.story.eyebrow} title={t.story.title} text={t.story.text} />
        <a href={locale === 'ja' ? '/about/' : `/${locale}/about/`} class="mt-8 inline-flex items-center gap-3 border-b border-wood/35 pb-1 text-sm text-wood transition hover:border-ticket hover:text-ticket">{t.story.readMore} <span>→</span></a>
      </div>

      <div class="relative pl-5 sm:pl-12">
        <div class="absolute bottom-0 left-[4px] top-2 w-px bg-ticket/45 sm:left-[20px]"></div>
        <ol class="space-y-12">
          {tl.map((item) => (
            <li class="relative grid gap-3 sm:grid-cols-[110px_1fr] sm:gap-8" data-reveal>
              <span class="absolute -left-[20px] top-1.5 size-3 rounded-full border-[3px] border-paper bg-ticket sm:-left-[38px]"></span>
              <div>
                <p class="font-serif-jp text-2xl text-ticket">{item.year}</p>
                <p class="mt-1 text-[10px] tracking-[0.16em] text-ink-soft/65">{item.era}</p>
              </div>
              <div>
                <h3 class="font-serif-jp text-xl tracking-[0.04em] text-wood-deep">{item.title}</h3>
                <p class="mt-3 text-sm leading-7 text-ink-soft sm:text-base sm:leading-8">{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-paper-deep/55 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading eyebrow={t.highlights.eyebrow} title={t.highlights.title} text={t.highlights.text} />

      <div class="mt-14 space-y-16 sm:mt-20 sm:space-y-24">
        {hl.map((item, index) => (
          <article class:list={['grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-16', index % 2 === 1 && 'lg:[&>div:first-child]:order-2']} data-reveal>
            <div class="photo-frame aspect-[4/3] rounded-[1.8rem]">
              <img src={item.image} srcset={`${item.imageSmall} 640w, ${item.image} 1440w`} sizes="(min-width:1024px) 50vw, 100vw" width="1440" height="1080" loading="lazy" alt={item.alt} />
            </div>
            <div class="max-w-lg">
              <p class="font-serif-jp text-5xl text-ticket/55">{item.number}</p>
              <h3 class="mt-4 font-serif-jp text-3xl leading-relaxed tracking-[0.05em] text-wood-deep">{item.title}</h3>
              <p class="mt-5 text-base leading-8 text-ink-soft">{item.text}</p>
              <a href={locale === 'ja' ? '/guide/' : `/${locale}/guide/`} class="mt-7 inline-flex items-center gap-3 text-sm text-wood hover:text-ticket">{t.highlights.pointLink} <span>→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <SectionHeading eyebrow={t.plan.eyebrow} title={t.plan.title} text={t.plan.text} align="center" />

    <div class="mt-14 grid gap-5 sm:mt-16 md:grid-cols-3">
      {t.plan.cards.map((card) => (
        <article class="rounded-[1.7rem] border border-wood/10 bg-white/65 p-7" data-reveal>
          <span class="text-xs tracking-[0.18em] text-ticket">{card.kicker}</span>
          <h3 class="mt-5 font-serif-jp text-2xl leading-relaxed">{card.titleLines[0]}<br />{card.titleLines[1]}</h3>
          <p class="mt-4 text-sm leading-7 text-ink-soft">{card.text}</p>
          <p class="mt-7 border-t border-wood/10 pt-4 text-xs text-ink-soft/70">{card.note}</p>
        </article>
      ))}
    </div>

    <div class="mt-8"><RouteMap locale={locale} /></div>
  </section>

  <section class="overflow-hidden bg-wood-deep text-white">
    <div class="mx-auto grid max-w-7xl lg:grid-cols-[1.05fr_0.95fr]">
      <div class="photo-frame min-h-[420px] lg:min-h-[650px]">
        <img src="/images/station-1440.webp" srcset="/images/station-640.webp 640w, /images/station-960.webp 960w, /images/station-1440.webp 1440w" sizes="(min-width:1024px) 55vw, 100vw" width="1440" height="1080" loading="lazy" alt={pages[locale].access.hero.alt} />
      </div>
      <div class="flex items-center px-6 py-16 sm:px-12 lg:px-16">
        <div class="max-w-lg" data-reveal>
          <p class="rule-line text-xs tracking-[0.2em] text-ticket-soft">{t.beforeYouGo.eyebrow}</p>
          <h2 class="mt-6 font-serif-jp text-4xl leading-[1.5] tracking-[0.06em]">{t.beforeYouGo.title}</h2>
          <ul class="mt-9 divide-y divide-white/12 border-y border-white/12 text-sm">
            {t.beforeYouGo.items.map((item) => (
              <li class="flex gap-5 py-5"><span class="text-ticket-soft">一</span><span class="leading-7 text-white/72">{item}</span></li>
            ))}
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={locale === 'ja' ? '/access/' : `/${locale}/access/`} class="rounded-full bg-ticket px-6 py-3.5 text-sm text-wood-deep hover:bg-ticket-soft">{t.beforeYouGo.cta1}</a>
            <a href={locale === 'ja' ? '/faq/' : `/${locale}/faq/`} class="rounded-full border border-white/25 px-6 py-3.5 text-sm hover:bg-white/10">{t.beforeYouGo.cta2}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28 lg:px-10" id="nearby">
    <SectionHeading eyebrow="EXPLORE TOKACHI" title={{ ja: '幸福駅から、もう一歩先へ。', zh: '幸福車站周邊值得順遊', en: 'Explore beyond Kofuku Station', ko: '고후쿠역 주변 함께 둘러보기' }[locale]} text={{ ja: '旧広尾線の物語と十勝の田園風景をつなぐ、近隣の二つの場所。', zh: '串聯舊廣尾線歷史與十勝田園景觀的兩處周邊景點。', en: 'Two distinct stops for railway heritage and the Tokachi countryside.', ko: '옛 철도 역사와 도카치 전원 풍경을 만나는 두 곳.' }[locale]} />
    <div class="mt-10 grid gap-7 md:grid-cols-2">
      {nearbySlugs.map((slug, index) => <a href={localizedPath(`/nearby/${slug}/`, locale)} class="group overflow-hidden rounded-[1.8rem] border border-wood/10 bg-white/75 transition hover:shadow-soft"><div class="photo-frame aspect-[16/9]"><img class="h-full w-full object-cover" src={nearbyInfo[slug].photo} loading="lazy" alt={nearbyText[locale][slug].name} /></div><div class="p-7"><h3 class="font-serif-jp text-2xl text-wood-deep">{nearbyText[locale][slug].name}</h3><p class="mt-3 text-sm leading-7 text-ink-soft">{nearbyText[locale][slug].tagline}</p><p class="mt-5 text-sm text-wood">{index < 2 ? nearbyDistance[locale][index] : nearbyInfo[slug].distance} →</p></div></a>)}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <SectionHeading eyebrow={t.faqSection.eyebrow} title={t.faqSection.title} text={t.faqSection.text} align="center" />
    <div class="mt-12 divide-y divide-wood/12 border-y border-wood/12">
      {fq.slice(0, 5).map((item) => (
        <details class="group py-1" data-reveal>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-serif-jp text-lg tracking-[0.03em] marker:content-none">
            <span>{item.q}</span><span class="text-2xl font-light text-ticket transition group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <p class="max-w-3xl pb-7 pr-10 text-sm leading-8 text-ink-soft">{item.a}</p>
        </details>
      ))}
    </div>
    <div class="mt-9 text-center"><a href={locale === 'ja' ? '/faq/' : `/${locale}/faq/`} class="inline-flex items-center gap-3 text-sm text-wood hover:text-ticket">{t.faqSection.viewAll} <span>→</span></a></div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-8 sm:px-8 lg:px-10">
    <div class="ticket-edge rounded-[2rem] px-8 py-14 text-center sm:px-14 sm:py-18" data-reveal>
      <p class="text-xs tracking-[0.24em] text-ticket">{t.cta.kicker}</p>
      <h2 class="mt-5 font-serif-jp text-3xl leading-relaxed tracking-[0.06em] text-wood-deep sm:text-5xl">{t.cta.title}</h2>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-ink-soft sm:text-base">{t.cta.text}</p>
      <a href={locale === 'ja' ? '/access/' : `/${locale}/access/`} class="mt-8 inline-flex items-center gap-3 rounded-full bg-wood-deep px-7 py-4 text-sm text-white hover:bg-wood">{t.cta.button} <span>→</span></a>
    </div>
  </section>
</BaseLayout>
