---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import RouteMap from '../../components/RouteMap.astro';
import { pages, ui } from '../../i18n';
import { site } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props { locale: Locale; title?: string; description?: string; }
const { locale, title, description } = Astro.props;
const t = pages[locale].access;
const ut = ui[locale];

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: '幸福駅',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '幸福町東1線161',
    addressLocality: '帯広市',
    addressRegion: '北海道',
    postalCode: '089-1246',
    addressCountry: 'JP',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.coordinates.lat, longitude: site.coordinates.lng },
};

const modesData = {
  car: t.travelModes.car,
  bus: t.travelModes.bus,
  airport: t.travelModes.airport,
};
const copyDone = ut.copyDone;
const copyFail = ut.copyFail;

const diagramLabel: Record<Locale, string> = { ja: '概略図', zh: '示意圖', en: 'Schematic', ko: '개략도' };

const diagram: Record<Locale, { road: string; cars: string; station: string; bell: string; parking: string; bus: string }> = {
  ja: { road: '国道236号方面', cars: '保存車両・ホーム', station: '幸福駅舎', bell: '幸福の鐘', parking: '無料駐車場', bus: '「幸福」バス停方面' },
  zh: { road: '國道236號方向', cars: '保存車輛・月台', station: '幸福車站房', bell: '幸福之鐘', parking: '免費停車場', bus: '「幸福」巴士站方向' },
  en: { road: 'Toward Rt.236', cars: 'Cars & platform', station: 'Kofuku station house', bell: 'Bell of Happiness', parking: 'Free parking', bus: '“Kofuku” bus stop' },
  ko: { road: '국도 236호 방면', cars: '보존 차량·승강장', station: '행복역사', bell: '행복의 종', parking: '무료 주차장', bus: '「행복」 버스정류장 방면' },
};
const dg = diagram[locale];

const langPath = locale === 'ja' ? '' : `/${locale}`;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: site.name, item: `${site.url}${langPath}/` },
    { '@type': 'ListItem', position: 2, name: title ?? ut.nav.access, item: `${site.url}${langPath}/access/` },
  ],
};
---
<BaseLayout locale={locale} path="/access/" title={title ?? ut.nav.access} description={description ?? t.hero.intro} image={t.hero.image} jsonLd={[placeSchema, breadcrumbSchema]}>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} intro={t.hero.intro} image={t.hero.image} imageSmall={t.hero.imageSmall} alt={t.hero.alt} breadcrumb={ut.nav.access} />

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24 lg:px-10">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {t.introCards.map(([label, value, note]) => (
        <div class="rounded-[1.5rem] border border-wood/10 bg-white/65 p-6" data-reveal>
          <p class="text-xs tracking-[0.16em] text-ink-soft">{label}</p>
          <p class="mt-3 font-serif-jp text-2xl text-wood-deep">{value}</p>
          <p class="mt-2 text-xs leading-5 text-ink-soft/65">{note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div data-reveal>
        <SectionHeading eyebrow={t.choose.eyebrow} title={t.choose.title} text={t.choose.text} />
        <div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label={t.choose.eyebrow}>
          {t.choose.tabs.map((tab, i) => (
            <button type="button" class:list={['travel-tab rounded-full px-5 py-3 text-sm', i === 0 ? 'bg-wood-deep text-white' : 'border border-wood/15 bg-white/65 text-sm']} data-mode={tab.key} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{tab.label}</button>
          ))}
        </div>
      </div>

      <div id="travel-panel" class="rounded-[2rem] bg-ticket-pale p-7 sm:p-10" aria-live="polite" data-reveal>
        <p id="travel-kicker" class="text-xs tracking-[0.2em] text-ticket">BY CAR</p>
        <h2 id="travel-title" class="mt-4 font-serif-jp text-3xl leading-relaxed text-wood-deep"></h2>
        <p id="travel-body" class="mt-5 text-base leading-8 text-ink-soft"></p>
        <ul id="travel-list" class="mt-7 grid gap-3 text-sm leading-7 text-ink-soft"></ul>
      </div>
    </div>
  </section>

  <section class="bg-paper-deep/55 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading eyebrow={t.routes.eyebrow} title={t.routes.title} text={t.routes.text} />
      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        {t.routes.cards.map((card) => (
          <article class="rounded-[1.7rem] bg-paper p-7 sm:p-8" data-reveal>
            <p class="text-xs tracking-[0.18em] text-ticket">{card.kicker}</p>
            <h3 class="mt-4 font-serif-jp text-2xl">{card.title}</h3>
            <p class="mt-5 text-sm leading-8 text-ink-soft">{card.text}</p>
            <p class="mt-5 border-t border-wood/10 pt-4 text-xs leading-6 text-ink-soft/65">{card.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <SectionHeading eyebrow={t.hours.eyebrow} title={t.hours.title} text={t.hours.text} />
    <div class="mt-14 grid gap-5 sm:grid-cols-3">
      {t.hours.items.map((item) => (
        <div class="rounded-[1.7rem] border border-wood/10 bg-white/65 p-7" data-reveal>
          <p class="text-xs tracking-[0.16em] text-ink-soft">{item.label}</p>
          <p class="mt-3 font-serif-jp text-2xl text-wood-deep">{item.value}</p>
          <p class="mt-2 text-xs leading-5 text-ink-soft/65">{item.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <SectionHeading eyebrow={t.shopHours.eyebrow} title={t.shopHours.title} text={t.shopHours.text} />
    <div class="mt-14 grid gap-5 sm:grid-cols-2">
      {t.shopHours.rows.map((row) => (
        <div class="rounded-[1.7rem] border border-wood/10 bg-white/65 p-7" data-reveal>
          <p class="text-xs tracking-[0.16em] text-ink-soft">{row.label}</p>
          <p class="mt-3 font-serif-jp text-2xl text-wood-deep">{row.value}</p>
          <p class="mt-2 text-xs leading-5 text-ink-soft/65">{row.note}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-xs leading-6 text-ink-soft/65">
      {ut.sourceLabel}：{t.shopHours.source}（{ut.lastUpdated} {t.shopHours.checked}）<br />
      {t.shopHours.caution}
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32 lg:px-10">
    <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="relative min-h-[460px] overflow-hidden rounded-[2rem] border border-wood/10 bg-white/65 p-7 sm:p-10" data-reveal>
        <p class="text-xs tracking-[0.18em] text-ticket">{diagramLabel[locale]} · NOT TO SCALE</p>
        <div class="relative mt-10 h-[330px]">
          <div class="absolute left-[9%] right-[10%] top-1/2 h-2 -translate-y-1/2 rounded-full bg-wood/18"></div>
          <div class="absolute bottom-[12%] left-[34%] top-[8%] w-1 rounded-full bg-rail/65"></div>
          <div class="absolute left-[8%] top-[39%] rounded-2xl border border-wood/10 bg-paper px-4 py-3 text-sm shadow-sm">{dg.road}</div>
          <div class="absolute left-[25%] top-[7%] rounded-2xl bg-rail px-4 py-3 text-sm text-white">{dg.cars}</div>
          <div class="absolute left-[43%] top-[39%] rounded-2xl border-2 border-ticket bg-ticket-pale px-5 py-4 font-serif-jp text-lg text-wood-deep">{dg.station}</div>
          <div class="absolute bottom-[9%] left-[47%] rounded-2xl border border-wood/10 bg-paper px-4 py-3 text-sm">{dg.bell}</div>
          <div class="absolute right-[7%] top-[38%] rounded-2xl border border-wood/10 bg-paper px-4 py-3 text-sm">{dg.parking}</div>
          <div class="absolute bottom-[4%] right-[14%] rounded-2xl bg-sky/30 px-4 py-3 text-sm">{dg.bus}</div>
        </div>
        <p class="mt-3 text-xs leading-6 text-ink-soft/60">{t.atStation.copyNote}</p>
      </div>

      <div class="space-y-5">
        <div class="rounded-[1.7rem] bg-wood-deep p-7 text-white sm:p-8" data-reveal>
          <p class="text-xs tracking-[0.18em] text-ticket-soft">{t.atStation.addressLabel}</p>
          <p class="mt-4 font-serif-jp text-2xl leading-relaxed">{site.postalAddress}</p>
          <p class="mt-4 text-sm text-white/62">緯度 {site.coordinates.lat} / 経度 {site.coordinates.lng}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <button id="copy-address" type="button" class="rounded-full bg-ticket px-5 py-3 text-sm text-wood-deep">{ut.copyAddress}</button>
            <a href="https://www.google.com/maps/dir/?api=1&destination=42.745315%2C143.1616703" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-5 py-3 text-sm hover:bg-white/10">{t.atStation.mapApp}</a>
          </div>
          <p id="copy-status" class="mt-3 min-h-5 text-xs text-ticket-soft" aria-live="polite"></p>
        </div>
        <div class="rounded-[1.7rem] border border-wood/10 bg-white/65 p-7 sm:p-8" data-reveal>
          <p class="text-xs tracking-[0.18em] text-ticket">{t.atStation.busLabel}</p>
          <h3 class="mt-3 font-serif-jp text-2xl">{t.atStation.busTitle}</h3>
          <p class="mt-4 text-sm leading-7 text-ink-soft">{t.atStation.busText}</p>
          <a href="https://www.tokachibus.jp/routebus/obihiro-hiroo/" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 text-sm text-wood underline decoration-wood/25 hover:decoration-wood">{t.atStation.busLink}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper-deep/55 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading eyebrow={t.map.eyebrow} title={t.map.title} text={t.map.text} />
      <div class="mt-12 overflow-hidden rounded-[2rem] border border-wood/10 bg-paper shadow-sm" data-reveal>
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2930.0348461761905!2d143.1590953761291!3d42.74531497115971!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5f738c16d5fc16f7%3A0xcc0fb4eb544c5a61!2z5bm456aP6aeF6Leh!5e0!3m2!1sja!2sjp!4v1785399834131!5m2!1sja!2sjp"
          width="600"
          height="450"
          class="h-[420px] w-full sm:h-[560px]"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title={t.map.title}
        ></iframe>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-12 sm:px-8 lg:px-10">
    <RouteMap locale={locale} />
  </section>

  <script define:vars={{ modes: modesData, copyDone, copyFail }}>
    const tabEls = document.querySelectorAll('.travel-tab');
    const kicker = document.querySelector('#travel-kicker');
    const title = document.querySelector('#travel-title');
    const body = document.querySelector('#travel-body');
    const list = document.querySelector('#travel-list');

    tabEls.forEach((tab) => tab.addEventListener('click', () => {
      const mode = tab.dataset.mode;
      const data = modes[mode];
      if (!data || !kicker || !title || !body || !list) return;
      tabEls.forEach((item) => {
        const selected = item === tab;
        item.setAttribute('aria-selected', String(selected));
        item.className = selected
          ? 'travel-tab rounded-full bg-wood-deep px-5 py-3 text-sm text-white'
          : 'travel-tab rounded-full border border-wood/15 bg-white/65 px-5 py-3 text-sm';
      });
      kicker.textContent = data.kicker;
      title.textContent = data.title;
      body.textContent = data.body;
      list.innerHTML = data.items.map((item) => `<li class="flex gap-3"><span class="text-ticket">○</span><span>${item}</span></li>`).join('');
    }));

    const copyButton = document.querySelector('#copy-address');
    const copyStatus = document.querySelector('#copy-status');
    if (kicker && title && body && list) {
      const first = modes[document.querySelector('.travel-tab')?.dataset.mode || 'car'];
      kicker.textContent = first.kicker;
      title.textContent = first.title;
      body.textContent = first.body;
      list.innerHTML = first.items.map((item) => `<li class="flex gap-3"><span class="text-ticket">○</span><span>${item}</span></li>`).join('');
    }
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('〒089-1246 北海道帯広市幸福町東1線161');
        if (copyStatus) copyStatus.textContent = copyDone;
      } catch {
        if (copyStatus) copyStatus.textContent = copyFail;
      }
    });
  </script>
</BaseLayout>
