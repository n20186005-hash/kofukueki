---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { pages, ui } from '../../i18n';
import { site } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props { locale: Locale; title?: string; description?: string; }
const { locale, title, description } = Astro.props;
const t = pages[locale].aikoku;
const ut = ui[locale];

const langPath = locale === 'ja' ? '' : `/${locale}`;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: site.name, item: `${site.url}${langPath}/` },
    { '@type': 'ListItem', position: 2, name: title ?? ut.nav.aikoku, item: `${site.url}${langPath}/aikoku-kofuku/` },
  ],
};
---
<BaseLayout locale={locale} path="/aikoku-kofuku/" title={title ?? ut.nav.aikoku} description={description ?? t.hero.intro} image={t.hero.image} jsonLd={breadcrumbSchema}>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} intro={t.hero.intro} image={t.hero.image} imageSmall={t.hero.imageSmall} alt={t.hero.alt} breadcrumb={ut.nav.aikoku} />

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <div class="grid gap-6 md:grid-cols-3">
      {t.blocks.map((b) => (
        <div class="rounded-[1.9rem] border border-wood/10 bg-white/65 p-9" data-reveal>
          <p class="font-serif-jp text-sm tracking-[0.2em] text-ticket">{b.number}</p>
          <h2 class="mt-3 font-serif-jp text-2xl text-wood-deep">{b.title}</h2>
          <p class="mt-4 text-base leading-8 text-ink-soft">{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32 lg:px-10">
    <SectionHeading eyebrow={t.course.eyebrow} title={t.course.title} text={t.course.text} />
    <ol class="mt-14 space-y-5">
      {t.course.steps.map((s) => (
        <li class="rounded-[1.7rem] border border-wood/10 bg-white/65 p-7" data-reveal>
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-ticket px-3 py-1 text-xs font-medium text-wood-deep">{s.kicker}</span>
            <h3 class="font-serif-jp text-xl text-wood-deep">{s.title}</h3>
          </div>
          <p class="mt-3 text-base leading-8 text-ink-soft">{s.text}</p>
          <p class="mt-2 text-xs text-ink-soft/60">{s.note}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32 lg:px-10">
    <div class="rounded-[1.9rem] bg-wood-deep p-9 text-white" data-reveal>
      <p class="text-xs tracking-[0.18em] text-ticket-soft">{t.aikokuInfo.eyebrow}</p>
      <h2 class="mt-3 font-serif-jp text-2xl">{t.aikokuInfo.title}</h2>
      <p class="mt-4 text-sm leading-7 text-white/75">{t.aikokuInfo.text}</p>
      <ul class="mt-6 space-y-3 text-sm text-white/80">
        {t.aikokuInfo.items.map((it) => (
          <li class="flex gap-2"><span aria-hidden="true">·</span><span>{it}</span></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
