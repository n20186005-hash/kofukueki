---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { pages, ui } from '../../i18n';
import { site } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props { locale: Locale; title?: string; description?: string; }
const { locale, title, description } = Astro.props;
const t = pages[locale].ticket;
const ut = ui[locale];

const langPath = locale === 'ja' ? '' : `/${locale}`;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: site.name, item: `${site.url}${langPath}/` },
    { '@type': 'ListItem', position: 2, name: title ?? ut.nav.ticket, item: `${site.url}${langPath}/ticket/` },
  ],
};
---
<BaseLayout locale={locale} path="/ticket/" title={title ?? ut.nav.ticket} description={description ?? t.intro} image={t.hero.image} jsonLd={breadcrumbSchema}>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} intro={t.hero.intro} image={t.hero.image} imageSmall={t.hero.imageSmall} alt={t.hero.alt} breadcrumb={ut.nav.ticket} />

  <section class="mx-auto max-w-3xl px-5 py-24 sm:px-8 sm:py-28 lg:px-10">
    <p class="text-lg leading-8 text-ink-soft">{t.intro}</p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32 lg:px-10">
    <div class="grid gap-6 md:grid-cols-2">
      {t.blocks.map((b) => (
        <div class="rounded-[1.9rem] border border-wood/10 bg-white/65 p-9" data-reveal>
          <p class="font-serif-jp text-sm tracking-[0.2em] text-ticket">{b.number}</p>
          <h2 class="mt-3 font-serif-jp text-2xl text-wood-deep">{b.title}</h2>
          <p class="mt-4 text-base leading-8 text-ink-soft">{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-28 sm:px-8 sm:pb-36 lg:px-10">
    <div class="rounded-[1.9rem] bg-paper-soft p-8 sm:p-10" data-reveal>
      <h2 class="font-serif-jp text-xl text-wood-deep">{t.noteTitle}</h2>
      <p class="mt-4 text-sm leading-7 text-ink-soft/75">{t.noteText}</p>
    </div>
  </section>
</BaseLayout>
