---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import RouteMap from '../../components/RouteMap.astro';
import { site } from '../../data/site';

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: '幸福駅',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '幸福町東1線161',
    addressLocality: '帯広市',
    addressRegion: '北海道',
    postalCode: '089-1246',
    addressCountry: 'JP',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.coordinates.lat, longitude: site.coordinates.lng },
};
---
<BaseLayout title="アクセス・駐車場・バス" description="幸福駅への車、バス、空港からのアクセス、無料駐車場、周辺を巡るモデルルートを案内します。" image="/images/hero-1440.webp" jsonLd={placeSchema}>
  <PageHero eyebrow="ACCESS" title="幸福駅への行き方。" intro="帯広市街から南へ約30分。とかち帯広空港からは約10分。車が便利ですが、路線バスでも訪れることができます。" image="/images/hero-1440.webp" imageSmall="/images/hero-960.webp" alt="広い空と草地の中に建つ幸福駅" breadcrumb="アクセス" />

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24 lg:px-10">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['所在地', '帯広市幸福町', '東1線161'],
        ['帯広市街', '車で約30分', '道路状況により変動'],
        ['帯広空港', '車で約10分', '到着・出発日に便利'],
        ['駐車場', '無料・36台', '大型バス5台分を含む'],
      ].map(([label, value, note]) => (
        <div class="rounded-[1.5rem] border border-wood/10 bg-white/65 p-6" data-reveal>
          <p class="text-xs tracking-[0.16em] text-ink-soft">{label}</p>
          <p class="mt-3 font-serif-jp text-2xl text-wood-deep">{value}</p>
          <p class="mt-2 text-xs leading-5 text-ink-soft/65">{note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div data-reveal>
        <SectionHeading eyebrow="CHOOSE YOUR WAY" title="移動手段から選ぶ。" text="下のボタンで移動手段を切り替えると、訪問前に確認するポイントが変わります。" />
        <div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="移動手段">
          <button type="button" class="travel-tab rounded-full bg-wood-deep px-5 py-3 text-sm text-white" data-mode="car" role="tab" aria-selected="true">車・レンタカー</button>
          <button type="button" class="travel-tab rounded-full border border-wood/15 bg-white/65 px-5 py-3 text-sm" data-mode="bus" role="tab" aria-selected="false">路線バス</button>
          <button type="button" class="travel-tab rounded-full border border-wood/15 bg-white/65 px-5 py-3 text-sm" data-mode="airport" role="tab" aria-selected="false">空港から</button>
        </div>
      </div>

      <div id="travel-panel" class="rounded-[2rem] bg-ticket-pale p-7 sm:p-10" aria-live="polite" data-reveal>
        <p id="travel-kicker" class="text-xs tracking-[0.2em] text-ticket">BY CAR</p>
        <h2 id="travel-title" class="mt-4 font-serif-jp text-3xl leading-relaxed text-wood-deep">最も自由で、周辺も巡りやすい方法。</h2>
        <p id="travel-body" class="mt-5 text-base leading-8 text-ink-soft">帯広市街から約30分。幸福駅のあとに愛国駅、中札内、空港へ向かう旅程を組みやすく、冬季も防寒具を車に用意できます。</p>
        <ul id="travel-list" class="mt-7 grid gap-3 text-sm leading-7 text-ink-soft">
          <li class="flex gap-3"><span class="text-ticket">○</span><span>無料駐車場は普通車・大型バスを合わせて36台分。</span></li>
          <li class="flex gap-3"><span class="text-ticket">○</span><span>冬は圧雪・凍結・吹雪に備え、移動時間に余裕を。</span></li>
          <li class="flex gap-3"><span class="text-ticket">○</span><span>カーナビでは住所または緯度経度を入力。</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-paper-deep/55 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading eyebrow="ROUTE GUIDE" title="三つの出発点から。" text="時間は天候、渋滞、道路状況で変わります。特に冬は数字より余裕を優先してください。" />
      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        <article class="rounded-[1.7rem] bg-paper p-7 sm:p-8" data-reveal>
          <p class="text-xs tracking-[0.18em] text-ticket">FROM OBIHIRO</p>
          <h3 class="mt-4 font-serif-jp text-2xl">帯広駅・市街から</h3>
          <p class="mt-5 text-sm leading-8 text-ink-soft">車で南へ約30分。路線バスは帯広駅バスターミナルから十勝バス60番「広尾線」に乗り、「幸福」で下車後、徒歩約5分です。</p>
          <p class="mt-5 border-t border-wood/10 pt-4 text-xs leading-6 text-ink-soft/65">バス利用時は復路の便を先に確認してください。</p>
        </article>
        <article class="rounded-[1.7rem] bg-ticket-pale p-7 sm:p-8" data-reveal>
          <p class="text-xs tracking-[0.18em] text-ticket">FROM AIRPORT</p>
          <h3 class="mt-4 font-serif-jp text-2xl">とかち帯広空港から</h3>
          <p class="mt-5 text-sm leading-8 text-ink-soft">自動車・タクシーで約10分。フライト到着後の最初の観光、または出発前の最後の立ち寄り先として組み込みやすい距離です。</p>
          <p class="mt-5 border-t border-ticket/25 pt-4 text-xs leading-6 text-ink-soft/65">荷物・搭乗手続き・レンタカー返却時間を含めて計画を。</p>
        </article>
        <article class="rounded-[1.7rem] bg-paper p-7 sm:p-8" data-reveal>
          <p class="text-xs tracking-[0.18em] text-ticket">FROM NAKASATSUNAI</p>
          <h3 class="mt-4 font-serif-jp text-2xl">中札内方面から</h3>
          <p class="mt-5 text-sm leading-8 text-ink-soft">国道236号周辺から帯広方面へ戻る途中に立ち寄れます。道の駅や農家レストランと合わせ、半日の十勝南部コースに。</p>
          <p class="mt-5 border-t border-wood/10 pt-4 text-xs leading-6 text-ink-soft/65">各施設の営業時間と定休日を個別に確認してください。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <SectionHeading eyebrow="AT THE STATION" title="到着してから迷わないために。" text="幸福駅はコンパクトな観光地です。住所、駐車、バス停の位置関係を先に把握しておくと安心です。" />
    <div class="mt-14 grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="relative min-h-[460px] overflow-hidden rounded-[2rem] border border-wood/10 bg-white/65 p-7 sm:p-10" data-reveal>
        <p class="text-xs tracking-[0.18em] text-ticket">概略図 · NOT TO SCALE</p>
        <div class="relative mt-10 h-[330px]">
          <div class="absolute left-[9%] right-[10%] top-1/2 h-2 -translate-y-1/2 rounded-full bg-wood/18"></div>
          <div class="absolute bottom-[12%] left-[34%] top-[8%] w-1 rounded-full bg-rail/65"></div>
          <div class="absolute left-[8%] top-[39%] rounded-2xl border border-wood/10 bg-paper px-4 py-3 text-sm shadow-sm">国道236号方面</div>
          <div class="absolute left-[25%] top-[7%] rounded-2xl bg-rail px-4 py-3 text-sm text-white">保存車両・ホーム</div>
          <div class="absolute left-[43%] top-[39%] rounded-2xl border-2 border-ticket bg-ticket-pale px-5 py-4 font-serif-jp text-lg text-wood-deep">幸福駅舎</div>
          <div class="absolute bottom-[9%] left-[47%] rounded-2xl border border-wood/10 bg-paper px-4 py-3 text-sm">幸福の鐘</div>
          <div class="absolute right-[7%] top-[38%] rounded-2xl border border-wood/10 bg-paper px-4 py-3 text-sm">無料駐車場</div>
          <div class="absolute bottom-[4%] right-[14%] rounded-2xl bg-sky/30 px-4 py-3 text-sm">「幸福」バス停方面</div>
        </div>
        <p class="mt-3 text-xs leading-6 text-ink-soft/60">現地の案内標識、立入表示、駐車誘導を優先してください。</p>
      </div>

      <div class="space-y-5">
        <div class="rounded-[1.7rem] bg-wood-deep p-7 text-white sm:p-8" data-reveal>
          <p class="text-xs tracking-[0.18em] text-ticket-soft">ADDRESS</p>
          <p class="mt-4 font-serif-jp text-2xl leading-relaxed">{site.postalAddress}</p>
          <p class="mt-4 text-sm text-white/62">緯度 {site.coordinates.lat} / 経度 {site.coordinates.lng}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <button id="copy-address" type="button" class="rounded-full bg-ticket px-5 py-3 text-sm text-wood-deep">住所をコピー</button>
            <a href="https://www.google.com/maps/dir/?api=1&destination=42.745315%2C143.1616703" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-5 py-3 text-sm hover:bg-white/10">地図アプリで経路検索 ↗</a>
          </div>
          <p id="copy-status" class="mt-3 min-h-5 text-xs text-ticket-soft" aria-live="polite"></p>
        </div>
        <div class="rounded-[1.7rem] border border-wood/10 bg-white/65 p-7 sm:p-8" data-reveal>
          <p class="text-xs tracking-[0.18em] text-ticket">BUS CHECK</p>
          <h3 class="mt-3 font-serif-jp text-2xl">十勝バス 60番・広尾線</h3>
          <p class="mt-4 text-sm leading-7 text-ink-soft">時刻は改定されるため、このサイトでは固定表示していません。訪問日を決めたら、往路と復路を同じ時刻表で確認してください。</p>
          <a href="https://www.tokachibus.jp/routebus/obihiro-hiroo/" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 text-sm text-wood underline decoration-wood/25 hover:decoration-wood">十勝バスの最新案内を確認 ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper-deep/55 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading
        eyebrow="LOCATION MAP"
        title="地図で幸福駅を確認。"
        text="帯広市街、とかち帯広空港、国道236号との位置関係を確認し、利用する交通手段に合わせて経路を選べます。"
      />
      <div class="mt-12 overflow-hidden rounded-[2rem] border border-wood/10 bg-paper shadow-sm" data-reveal>
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2930.0348461761905!2d143.1590953761291!3d42.74531497115971!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5f738c16d5fc16f7%3A0xcc0fb4eb544c5a61!2z5bm456aP6aeF6Leh!5e0!3m2!1sja!2sjp!4v1785399834131!5m2!1sja!2sjp"
          width="600"
          height="450"
          class="h-[420px] w-full sm:h-[560px]"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="幸福駅跡のGoogleマップ"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-12 sm:px-8 lg:px-10">
    <RouteMap />
  </section>

  <script>
    const modes = {
      car: {
        kicker: 'BY CAR',
        title: '最も自由で、周辺も巡りやすい方法。',
        body: '帯広市街から約30分。幸福駅のあとに愛国駅、中札内、空港へ向かう旅程を組みやすく、冬季も防寒具を車に用意できます。',
        items: ['無料駐車場は普通車・大型バスを合わせて36台分。', '冬は圧雪・凍結・吹雪に備え、移動時間に余裕を。', 'カーナビでは住所または緯度経度を入力。'],
      },
      bus: {
        kicker: 'BY BUS',
        title: '車がなくても、幸福へ。',
        body: '帯広駅バスターミナルから十勝バス60番・広尾線を利用し、「幸福」停留所から徒歩約5分です。便数が限られるため、計画性が必要です。',
        items: ['往路と復路を必ずセットで確認。', '遅延や天候を考え、帰りの一本前も把握。', '停留所からは歩きやすい靴がおすすめ。'],
      },
      airport: {
        kicker: 'FROM AIRPORT',
        title: '十勝の最初、または最後の一駅。',
        body: 'とかち帯広空港から車・タクシーで約10分。短い距離ですが、搭乗前は道路状況や手続き時間を含めて余裕を持ってください。',
        items: ['レンタカーの受取・返却時間を別に確保。', '大きな荷物は車内や空港ロッカーの利用を検討。', '冬季・悪天候時はフライト情報も確認。'],
      },
    };

    const tabs = document.querySelectorAll<HTMLButtonElement>('.travel-tab');
    const kicker = document.querySelector('#travel-kicker');
    const title = document.querySelector('#travel-title');
    const body = document.querySelector('#travel-body');
    const list = document.querySelector('#travel-list');

    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const mode = tab.dataset.mode as keyof typeof modes;
      const data = modes[mode];
      if (!data || !kicker || !title || !body || !list) return;
      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute('aria-selected', String(selected));
        item.className = selected
          ? 'travel-tab rounded-full bg-wood-deep px-5 py-3 text-sm text-white'
          : 'travel-tab rounded-full border border-wood/15 bg-white/65 px-5 py-3 text-sm';
      });
      kicker.textContent = data.kicker;
      title.textContent = data.title;
      body.textContent = data.body;
      list.innerHTML = data.items.map((item) => `<li class="flex gap-3"><span class="text-ticket">○</span><span>${item}</span></li>`).join('');
    }));

    const copyButton = document.querySelector<HTMLButtonElement>('#copy-address');
    const copyStatus = document.querySelector('#copy-status');
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('〒089-1246 北海道帯広市幸福町東1線161');
        if (copyStatus) copyStatus.textContent = '住所をコピーしました。';
      } catch {
        if (copyStatus) copyStatus.textContent = 'コピーできませんでした。住所を選択してコピーしてください。';
      }
    });
  </script>
</BaseLayout>
