---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { faqs, site } from '../../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
  url: `${site.url}/faq/`,
};
---
<BaseLayout title="よくある質問" description="幸福駅の料金、見学時間、滞在時間、バス、駐車場、冬の訪問、愛国駅との周遊など、よくある質問に答えます。" image="/images/bell-1440.webp" jsonLd={faqSchema}>
  <PageHero eyebrow="FAQ" title="幸福駅へ行く前の、よくある質問。" intro="料金、時間、交通、冬の服装。旅の前に気になることを、できるだけ簡潔にまとめました。" image="/images/bell-1440.webp" imageSmall="/images/bell-640.webp" alt="幸福駅の幸福の鐘と駅舎へ続く道" breadcrumb="よくある質問" />

  <section class="mx-auto max-w-5xl px-5 py-24 sm:px-8 sm:py-32">
    <div class="divide-y divide-wood/12 border-y border-wood/12">
      {faqs.map((item, index) => (
        <details class="group" open={index === 0} data-reveal>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-7 marker:content-none sm:py-8">
            <span class="flex gap-4 sm:gap-6">
              <span class="mt-1 font-serif-jp text-lg text-ticket">Q.</span>
              <span class="font-serif-jp text-lg leading-relaxed tracking-[0.03em] text-wood-deep sm:text-xl">{item.q}</span>
            </span>
            <span class="mt-1 shrink-0 text-2xl font-light text-ticket transition group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <div class="grid pb-8 pl-0 sm:grid-cols-[44px_1fr] sm:pl-1">
            <span class="hidden font-serif-jp text-lg text-sky sm:block">A.</span>
            <p class="max-w-3xl text-sm leading-8 text-ink-soft sm:text-base">{item.a}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="mt-12 rounded-[1.7rem] bg-ticket-pale p-7 sm:p-9" data-reveal>
      <p class="text-xs tracking-[0.18em] text-ticket">INFORMATION</p>
      <h2 class="mt-4 font-serif-jp text-2xl text-wood-deep">訪問前に最新情報をご確認ください。</h2>
      <p class="mt-4 text-sm leading-7 text-ink-soft">現地の営業、交通、積雪、イベントなどは変わります。このページは旅行計画の入口として利用し、当日は現地掲示と交通事業者の最新案内を優先してください。</p>
    </div>
  </section>
</BaseLayout>
