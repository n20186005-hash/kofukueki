---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const photos = [
  {
    src: '/images/hero-1920.webp',
    thumb: '/images/hero-960.webp',
    title: '青空と幸福駅',
    alt: '青空の下に建つ幸福駅と駅名標',
    ratio: 'aspect-[4/3]',
  },
  {
    src: '/images/interior-1280.webp',
    thumb: '/images/interior-480.webp',
    title: '願いに包まれた駅舎',
    alt: 'ピンク色の願い札で覆われた幸福駅の内部',
    ratio: 'aspect-[3/4]',
  },
  {
    src: '/images/train-1440.webp',
    thumb: '/images/train-640.webp',
    title: '朱色のキハ22形',
    alt: '幸福駅に保存されている朱色の鉄道車両',
    ratio: 'aspect-[4/3]',
  },
  {
    src: '/images/bell-1440.webp',
    thumb: '/images/bell-640.webp',
    title: '幸福の鐘',
    alt: '幸福駅の入口に立つ幸福の鐘',
    ratio: 'aspect-[4/3]',
  },
  {
    src: '/images/station-1440.webp',
    thumb: '/images/station-640.webp',
    title: '木造駅舎の佇まい',
    alt: '正面から見た幸福駅の木造駅舎',
    ratio: 'aspect-[4/3]',
  },
  {
    src: '/images/aikoku-568.webp',
    thumb: '/images/aikoku-568.webp',
    title: '物語の始発・愛国駅',
    alt: '旧愛国駅の駅舎と駅名標',
    ratio: 'aspect-[4/3]',
  },
];
---
<BaseLayout title="写真で見る幸福駅" description="駅舎、願い札、保存車両、幸福の鐘、愛国駅など、幸福駅の風景を実際の写真で紹介します。" image="/images/hero-1920.webp">
  <PageHero eyebrow="PHOTO NOTES" title="写真で歩く、幸福駅。" intro="木の色、願い札の淡い桃色、保存車両の朱色、十勝の空。現地で出会う色と質感を、実景写真で紹介します。" image="/images/hero-1920.webp" imageSmall="/images/hero-960.webp" alt="十勝の青空と幸福駅の駅舎" breadcrumb="写真で見る" />

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <SectionHeading eyebrow="GALLERY" title="六つの風景。" text="写真を選ぶと大きく表示できます。掲載写真はすべて利用条件を確認し、サイト内に最適化して保存しています。" />

    <div class="mt-14 columns-1 gap-5 sm:columns-2 lg:columns-3">
      {photos.map((photo, index) => (
        <figure class="mb-5 break-inside-avoid" data-reveal>
          <button
            type="button"
            class:list={['gallery-open photo-frame block w-full overflow-hidden rounded-[1.6rem] text-left', photo.ratio]}
            data-src={photo.src}
            data-alt={photo.alt}
            data-title={photo.title}
            aria-label={`${photo.title}を拡大表示`}
          >
            <img src={photo.thumb} width="960" height={index === 1 ? '1280' : '720'} loading="lazy" alt={photo.alt} />
            <span class="absolute bottom-4 right-4 grid size-10 place-items-center rounded-full bg-paper/90 text-xl text-wood shadow-sm" aria-hidden="true">＋</span>
          </button>
          <figcaption class="flex items-center justify-between gap-3 px-2 pt-3">
            <span class="font-serif-jp text-base text-wood-deep">{photo.title}</span>
            <span class="text-[10px] tracking-[0.14em] text-ink-soft/55">{String(index + 1).padStart(2, '0')}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8 sm:pb-32">
    <div class="grid gap-10 rounded-[2rem] bg-ticket-pale p-7 sm:p-12 lg:grid-cols-[0.85fr_1.15fr]" data-reveal>
      <div>
        <p class="text-xs tracking-[0.18em] text-ticket">TAKE YOUR PHOTO</p>
        <h2 class="mt-4 font-serif-jp text-3xl leading-relaxed text-wood-deep">幸福駅らしさを残す、三つの構図。</h2>
      </div>
      <ol class="space-y-6">
        <li class="grid grid-cols-[42px_1fr] gap-4"><span class="font-serif-jp text-2xl text-ticket">一</span><div><h3 class="font-serif-jp text-lg">駅名標と駅舎</h3><p class="mt-2 text-sm leading-7 text-ink-soft">「幸福」の文字が読める位置から、木造駅舎と空を広く入れます。</p></div></li>
        <li class="grid grid-cols-[42px_1fr] gap-4"><span class="font-serif-jp text-2xl text-ticket">二</span><div><h3 class="font-serif-jp text-lg">ホームの奥行き</h3><p class="mt-2 text-sm leading-7 text-ink-soft">板張りの線を生かし、保存車両へ視線が続く構図に。</p></div></li>
        <li class="grid grid-cols-[42px_1fr] gap-4"><span class="font-serif-jp text-2xl text-ticket">三</span><div><h3 class="font-serif-jp text-lg">願い札の細部</h3><p class="mt-2 text-sm leading-7 text-ink-soft">他人の個人情報が大きく写らないように注意し、色と重なりを切り取ります。</p></div></li>
      </ol>
    </div>
  </section>

  <dialog id="photo-dialog" class="m-auto max-h-[92vh] w-[min(92vw,1100px)] rounded-[1.5rem] bg-wood-deep p-0 text-white backdrop:bg-black/75">
    <div class="relative p-3 sm:p-5">
      <button id="photo-close" type="button" class="absolute right-5 top-5 z-10 grid size-11 place-items-center rounded-full bg-black/55 text-2xl text-white backdrop-blur" aria-label="写真を閉じる">×</button>
      <img id="photo-large" src="/images/hero-960.webp" alt="" class="max-h-[78vh] w-full rounded-[1rem] object-contain" />
      <p id="photo-caption" class="px-2 pb-2 pt-4 font-serif-jp text-lg"></p>
    </div>
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#photo-dialog');
    const image = document.querySelector<HTMLImageElement>('#photo-large');
    const caption = document.querySelector('#photo-caption');
    const close = document.querySelector<HTMLButtonElement>('#photo-close');

    document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog || !image || !caption) return;
        image.src = button.dataset.src || '';
        image.alt = button.dataset.alt || '';
        caption.textContent = button.dataset.title || '';
        dialog.showModal();
      });
    });
    close?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  </script>
</BaseLayout>
