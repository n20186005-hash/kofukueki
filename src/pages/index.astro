---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RouteMap from '../components/RouteMap.astro';
import { faqs, highlights, quickFacts, site, timeline } from '../data/site';

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: '幸福駅',
  alternateName: ['旧幸福駅', '幸福鉄道公園', 'Kofuku Station'],
  description: site.description,
  url: site.url,
  image: [`${site.url}/images/hero-1920.webp`, `${site.url}/images/station-1440.webp`],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '幸福町東1線161',
    addressLocality: '帯広市',
    addressRegion: '北海道',
    postalCode: '089-1246',
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.coordinates.lat,
    longitude: site.coordinates.lng,
  },
  touristType: ['鉄道ファン', 'カップル', '家族旅行', '写真旅行'],
};
---
<BaseLayout jsonLd={attractionSchema}>
  <section class="relative min-h-[calc(100svh-var(--header-height))] overflow-hidden bg-wood-deep text-white hero-vignette">
    <picture class="absolute inset-0">
      <source media="(max-width: 720px)" srcset="/images/hero-960.webp" />
      <source media="(max-width: 1500px)" srcset="/images/hero-1440.webp" />
      <img
        class="h-full w-full object-cover object-center"
        src="/images/hero-1920.webp"
        width="1920"
        height="1280"
        fetchpriority="high"
        alt="青空の下に建つ木造の幸福駅とピンク色の駅名標"
      />
    </picture>

    <div class="relative z-10 mx-auto flex min-h-[calc(100svh-var(--header-height))] max-w-7xl flex-col justify-end px-5 pb-10 pt-24 sm:px-8 sm:pb-14 lg:px-10 lg:pb-16">
      <div class="max-w-4xl" data-reveal>
        <p class="rule-line text-xs tracking-[0.25em] text-ticket-soft">旧国鉄広尾線・北海道帯広市</p>
        <h1 class="mt-7 text-balance font-serif-jp text-[clamp(3rem,8vw,7rem)] leading-[1.13] tracking-[0.08em]">
          愛の国から、<br />幸福へ。
        </h1>
        <p class="mt-7 max-w-2xl text-base leading-8 text-white/78 sm:text-lg">
          列車が走らなくなったあとも、願いはここに到着し続けています。<br class="hidden sm:block" />
          幸福駅の物語と、十勝を旅するための静かな案内所。
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/access/" class="inline-flex items-center gap-3 rounded-full bg-ticket px-6 py-3.5 text-sm font-medium text-wood-deep transition hover:bg-ticket-soft">
            アクセスを確認 <span aria-hidden="true">→</span>
          </a>
          <a href="#story" class="inline-flex items-center gap-3 rounded-full border border-white/35 bg-black/10 px-6 py-3.5 text-sm text-white backdrop-blur transition hover:bg-white/10">
            幸福駅を知る <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="mt-14 grid border-t border-white/20 pt-5 text-sm sm:grid-cols-3 sm:gap-8 lg:max-w-3xl" data-reveal>
        <div class="py-2"><span class="text-white/50">見学</span><strong class="ml-4 font-normal">無料</strong></div>
        <div class="py-2"><span class="text-white/50">空港から</span><strong class="ml-4 font-normal">車で約10分</strong></div>
        <div class="py-2"><span class="text-white/50">滞在目安</span><strong class="ml-4 font-normal">40–60分</strong></div>
      </div>
    </div>

    <p class="vertical-label absolute bottom-10 right-5 z-10 hidden text-[10px] tracking-[0.25em] text-white/45 md:block lg:right-10">KOFUKU STATION · TOKACHI</p>
  </section>

  <section class="relative z-20 mx-auto -mt-1 max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="grid overflow-hidden rounded-b-[2rem] bg-ticket-pale shadow-soft sm:grid-cols-2 lg:grid-cols-4">
      {quickFacts.map((item, index) => (
        <div class:list={['px-6 py-7 sm:px-8', index > 0 && 'border-t border-ticket/20 sm:border-t-0 sm:border-l']}>
          <p class="text-xs tracking-[0.16em] text-ink-soft">{item.label}</p>
          <p class="mt-2 font-serif-jp text-2xl tracking-[0.04em] text-wood-deep">{item.value}</p>
          <p class="mt-2 text-xs leading-5 text-ink-soft/75">{item.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="story" class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-24">
      <div class="lg:sticky lg:top-28">
        <SectionHeading
          eyebrow="STORY"
          title="小さな駅名が、全国の人を幸福へ運んだ。"
          text="幸福駅は、旧国鉄広尾線にあった小さな無人駅です。1970年代、「愛国から幸福へ」という言葉と記念切符が日本中に広がり、駅はひとつの願いの場所になりました。"
        />
        <a href="/about/" class="mt-8 inline-flex items-center gap-3 border-b border-wood/35 pb-1 text-sm text-wood transition hover:border-ticket hover:text-ticket">物語を詳しく読む <span>→</span></a>
      </div>

      <div class="relative pl-5 sm:pl-12">
        <div class="absolute bottom-0 left-[4px] top-2 w-px bg-ticket/45 sm:left-[20px]"></div>
        <ol class="space-y-12">
          {timeline.map((item) => (
            <li class="relative grid gap-3 sm:grid-cols-[110px_1fr] sm:gap-8" data-reveal>
              <span class="absolute -left-[20px] top-1.5 size-3 rounded-full border-[3px] border-paper bg-ticket sm:-left-[38px]"></span>
              <div>
                <p class="font-serif-jp text-2xl text-ticket">{item.year}</p>
                <p class="mt-1 text-[10px] tracking-[0.16em] text-ink-soft/65">{item.era}</p>
              </div>
              <div>
                <h3 class="font-serif-jp text-xl tracking-[0.04em] text-wood-deep">{item.title}</h3>
                <p class="mt-3 text-sm leading-7 text-ink-soft sm:text-base sm:leading-8">{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-paper-deep/55 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading
        eyebrow="THREE SCENES"
        title="幸福駅で出会う、三つの風景。"
        text="駅舎に残された言葉、鉄道の時間、旅の節目を告げる鐘。急がずに歩くと、場所の表情が少しずつ変わります。"
      />

      <div class="mt-14 space-y-16 sm:mt-20 sm:space-y-24">
        {highlights.map((item, index) => (
          <article class:list={['grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-16', index % 2 === 1 && 'lg:[&>div:first-child]:order-2']} data-reveal>
            <div class="photo-frame aspect-[4/3] rounded-[1.8rem]">
              <img
                src={item.image}
                srcset={`${item.imageSmall} 640w, ${item.image} 1440w`}
                sizes="(min-width:1024px) 50vw, 100vw"
                width="1440"
                height="1080"
                loading="lazy"
                alt={item.alt}
              />
            </div>
            <div class="max-w-lg">
              <p class="font-serif-jp text-5xl text-ticket/55">{item.number}</p>
              <h3 class="mt-4 font-serif-jp text-3xl leading-relaxed tracking-[0.05em] text-wood-deep">{item.title}</h3>
              <p class="mt-5 text-base leading-8 text-ink-soft">{item.text}</p>
              <a href="/guide/" class="mt-7 inline-flex items-center gap-3 text-sm text-wood hover:text-ticket">見学のポイント <span>→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <SectionHeading
      eyebrow="PLAN YOUR VISIT"
      title="旅程に、幸福をひと駅。"
      text="空港から近く、愛国駅や中札内とも組み合わせやすい幸福駅。移動手段に合わせて、無理のない過ごし方を選べます。"
      align="center"
    />

    <div class="mt-14 grid gap-5 md:grid-cols-3 sm:mt-16">
      <article class="rounded-[1.7rem] border border-wood/10 bg-white/65 p-7" data-reveal>
        <span class="text-xs tracking-[0.18em] text-ticket">01 · ARRIVAL</span>
        <h3 class="mt-5 font-serif-jp text-2xl leading-relaxed">空港から<br />最初の幸福へ</h3>
        <p class="mt-4 text-sm leading-7 text-ink-soft">とかち帯広空港から車で約10分。到着後に立ち寄り、帯広市街へ向かう短いコース。</p>
        <p class="mt-7 border-t border-wood/10 pt-4 text-xs text-ink-soft/70">目安：60–90分</p>
      </article>
      <article class="rounded-[1.7rem] border border-ticket/35 bg-ticket-pale p-7" data-reveal>
        <span class="text-xs tracking-[0.18em] text-ticket">02 · STORY</span>
        <h3 class="mt-5 font-serif-jp text-2xl leading-relaxed">愛国から<br />幸福へ</h3>
        <p class="mt-4 text-sm leading-7 text-ink-soft">愛国駅で鉄道の記憶に触れ、幸福駅へ。「愛の国から幸福へ」の言葉を実際の風景でたどるコース。</p>
        <p class="mt-7 border-t border-ticket/25 pt-4 text-xs text-ink-soft/70">目安：2–3時間</p>
      </article>
      <article class="rounded-[1.7rem] border border-wood/10 bg-white/65 p-7" data-reveal>
        <span class="text-xs tracking-[0.18em] text-ticket">03 · TOKACHI</span>
        <h3 class="mt-5 font-serif-jp text-2xl leading-relaxed">幸福の先へ<br />十勝の食を巡る</h3>
        <p class="mt-4 text-sm leading-7 text-ink-soft">幸福駅から中札内へ足を延ばし、農家レストランや道の駅で十勝の味を楽しむ半日コース。</p>
        <p class="mt-7 border-t border-wood/10 pt-4 text-xs text-ink-soft/70">目安：3–5時間</p>
      </article>
    </div>

    <div class="mt-8"><RouteMap /></div>
  </section>

  <section class="overflow-hidden bg-wood-deep text-white">
    <div class="mx-auto grid max-w-7xl lg:grid-cols-[1.05fr_0.95fr]">
      <div class="photo-frame min-h-[420px] lg:min-h-[650px]">
        <img src="/images/station-1440.webp" srcset="/images/station-640.webp 640w, /images/station-960.webp 960w, /images/station-1440.webp 1440w" sizes="(min-width:1024px) 55vw, 100vw" width="1440" height="1080" loading="lazy" alt="幸福駅の木造駅舎を正面から見た風景" />
      </div>
      <div class="flex items-center px-6 py-16 sm:px-12 lg:px-16">
        <div class="max-w-lg" data-reveal>
          <p class="rule-line text-xs tracking-[0.2em] text-ticket-soft">BEFORE YOU GO</p>
          <h2 class="mt-6 font-serif-jp text-4xl leading-[1.5] tracking-[0.06em]">訪れる前に、<br />知っておきたいこと。</h2>
          <ul class="mt-9 divide-y divide-white/12 border-y border-white/12 text-sm">
            <li class="flex gap-5 py-5"><span class="text-ticket-soft">一</span><span class="leading-7 text-white/72">屋外中心のため、十勝の風・雪・日差しに合わせた服装を。</span></li>
            <li class="flex gap-5 py-5"><span class="text-ticket-soft">二</span><span class="leading-7 text-white/72">バスは本数が限られます。往復の時刻を先に決めてください。</span></li>
            <li class="flex gap-5 py-5"><span class="text-ticket-soft">三</span><span class="leading-7 text-white/72">売店の営業は季節や天候で変わるため、現地案内を優先してください。</span></li>
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/access/" class="rounded-full bg-ticket px-6 py-3.5 text-sm text-wood-deep hover:bg-ticket-soft">アクセス案内</a>
            <a href="/faq/" class="rounded-full border border-white/25 px-6 py-3.5 text-sm hover:bg-white/10">よくある質問</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-24 sm:px-8 sm:py-32 lg:px-10">
    <SectionHeading eyebrow="FAQ" title="よくある質問" text="訪問前によく迷うポイントを、短くまとめました。" align="center" />
    <div class="mt-12 divide-y divide-wood/12 border-y border-wood/12">
      {faqs.slice(0, 5).map((item) => (
        <details class="group py-1" data-reveal>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-serif-jp text-lg tracking-[0.03em] marker:content-none">
            <span>{item.q}</span><span class="text-2xl font-light text-ticket transition group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <p class="max-w-3xl pb-7 pr-10 text-sm leading-8 text-ink-soft">{item.a}</p>
        </details>
      ))}
    </div>
    <div class="mt-9 text-center"><a href="/faq/" class="inline-flex items-center gap-3 text-sm text-wood hover:text-ticket">すべての質問を見る <span>→</span></a></div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-8 sm:px-8 lg:px-10">
    <div class="ticket-edge rounded-[2rem] px-8 py-14 text-center sm:px-14 sm:py-18" data-reveal>
      <p class="text-xs tracking-[0.24em] text-ticket">NEXT STOP</p>
      <h2 class="mt-5 font-serif-jp text-3xl leading-relaxed tracking-[0.06em] text-wood-deep sm:text-5xl">次の旅に、幸福駅を。</h2>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-ink-soft sm:text-base">住所・駐車場・バス停・空港からの行き方を、ひとつのページにまとめています。</p>
      <a href="/access/" class="mt-8 inline-flex items-center gap-3 rounded-full bg-wood-deep px-7 py-4 text-sm text-white hover:bg-wood">アクセスを見る <span>→</span></a>
    </div>
  </section>
</BaseLayout>
